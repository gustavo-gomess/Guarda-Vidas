# Copy to .env.local and adjust. Never commit .env files with real values.
# Every variable must also be declared in src/lib/env-schema.ts, which
# validates them when the server starts.
# Do not use the NEXT_PUBLIC_ prefix for secrets: those values are sent to the
# browser.

# PostgreSQL connection (required).
# The value below matches the local Docker database in docker-compose.yml and
# works only on your machine. Use the hosting provider's secret store in
# production.
DATABASE_URL="postgresql://guarda_vidas:guarda_vidas_dev@localhost:5432/guarda_vidas"

# Log level: debug | info | warn | error (optional, default: info).
LOG_LEVEL=info
