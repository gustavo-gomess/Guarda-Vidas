{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:run)",
      "Bash(npm run build)",
      "Bash(npm run format:check)",
      "PowerShell(git status)",
      "PowerShell(git diff)",
      "PowerShell(git log:*)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run test:run)",
      "PowerShell(npm run build)",
      "PowerShell(npm run format:check)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(Remove-Item -Recurse*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  }
}
