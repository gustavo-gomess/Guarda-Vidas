// Prisma schema. Business models are added by feature, each change through a
// reviewed migration (`npm run db:migrate -- --name <change>`).
// Connection settings live in prisma7.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Authentication profile. Captain and administrator are assignments, not
/// roles (see PostAssignment.isCaptain and User.isAdmin).
enum Role {
  AUTHORITY
  COORDINATOR
  LIFEGUARD
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Login identifier, stored lowercase.
  username            String    @unique
  name                String
  role                Role
  /// May manage user accounts, posts and coordinator areas.
  isAdmin             Boolean   @default(false)
  /// Inactive users cannot sign in; their sessions are revoked.
  active              Boolean   @default(true)
  passwordHash        String
  /// Set for temporary passwords; the user must choose a new one.
  mustChangePassword  Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions           Session[]
  coordinatedPosts   PostCoordinator[]
  assignments        PostAssignment[]
  auditEntries       AuditLog[]           @relation("AuditActor")
  openedWindows      AvailabilityWindow[]
  availabilities     Availability[]
  scheduleEntries    ScheduleEntry[]      @relation("ScheduledUser")
  createdEntries     ScheduleEntry[]      @relation("EntryCreator")
  confirmedSchedules Schedule[]           @relation("ScheduleConfirmer")
}

model Session {
  /// SHA-256 of the session token. The token itself is only in the cookie.
  id                String   @id
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  /// Idle expiry, extended on use up to absoluteExpiresAt.
  expiresAt         DateTime
  absoluteExpiresAt DateTime

  @@index([userId])
}

/// Operational state of a post. Provisional values (OD-03).
enum PostStatus {
  /// In service: schedules and team changes allowed.
  OPERATING
  /// Temporarily out of service: no new schedule entries.
  SUSPENDED
  /// Deactivated: kept for history only.
  INACTIVE
}

model Post {
  id        String     @id @default(uuid()) @db.Uuid
  /// Short identifier chosen by the administrator, e.g. "P-01". Uppercase.
  code      String     @unique
  name      String     @unique
  /// Free-text location (beach, reference point).
  location  String     @default("")
  /// Information needed for the service, until OD-03 defines fields.
  notes     String     @default("")
  status    PostStatus @default(OPERATING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  coordinators PostCoordinator[]
  assignments  PostAssignment[]
  schedules    Schedule[]
  auditEntries AuditLog[]
}

/// A coordinator's area of responsibility.
model PostCoordinator {
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/// A lifeguard's base assignment to a post (the post's team). Only team
/// members can be scheduled at the post.
model PostAssignment {
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isCaptain Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/// Append-only change history. Never updated or deleted by the application.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now())
  /// Null only for changes made by the command-line bootstrap.
  actorId    String?  @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  /// Post the change belongs to, when it has one.
  postId     String?  @db.Uuid
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Restrict)
  /// Changed fields only. Never contains password hashes or tokens.
  before     Json?
  after      Json?
  /// Justification, required for some changes (e.g. confirmed schedules).
  reason     String?

  @@index([entityType, entityId])
  @@index([postId, createdAt])
  @@index([actorId, createdAt])
}

enum AvailabilityWindowStatus {
  /// Lifeguards can send or change their availability.
  OPEN
  /// No more changes to availability.
  CLOSED
}

/// Three consecutive days for which lifeguards declare availability.
/// Windows never overlap (checked by the application).
model AvailabilityWindow {
  id          String                   @id @default(uuid()) @db.Uuid
  /// First day; the window covers startDate and the two following days.
  startDate   DateTime                 @unique @db.Date
  status      AvailabilityWindowStatus @default(OPEN)
  createdById String                   @db.Uuid
  createdBy   User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  availabilities Availability[]
  schedules      Schedule[]
}

/// Availability sent by a lifeguard for one window ("disponibilidade
/// enviada"). It is a declaration only: it never becomes a schedule by itself.
model Availability {
  windowId    String             @db.Uuid
  window      AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)
  userId      String             @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  day1        Boolean
  day2        Boolean
  day3        Boolean
  note        String             @default("")
  submittedAt DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@id([windowId, userId])
  @@index([userId])
}

enum ScheduleStatus {
  /// Being assembled by the coordinator. Not visible to lifeguards.
  PROPOSED
  /// Confirmed by the coordinator and published.
  CONFIRMED
  /// Changed after confirmation (each change has a justification).
  CHANGED
}

/// Schedule of one post for one availability window.
model Schedule {
  id            String             @id @default(uuid()) @db.Uuid
  postId        String             @db.Uuid
  post          Post               @relation(fields: [postId], references: [id], onDelete: Restrict)
  windowId      String             @db.Uuid
  window        AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)
  status        ScheduleStatus     @default(PROPOSED)
  confirmedAt   DateTime?
  confirmedById String?            @db.Uuid
  confirmedBy   User?              @relation("ScheduleConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  entries ScheduleEntry[]

  @@unique([postId, windowId])
  @@index([windowId])
}

/// One lifeguard at one post on one day.
model ScheduleEntry {
  id          String   @id @default(uuid()) @db.Uuid
  scheduleId  String   @db.Uuid
  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  userId      String   @db.Uuid
  user        User     @relation("ScheduledUser", fields: [userId], references: [id], onDelete: Restrict)
  /// Operational day (America/Sao_Paulo calendar date).
  date        DateTime @db.Date
  createdById String   @db.Uuid
  createdBy   User     @relation("EntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  /// A person is at one post per day, in any schedule state (one shift per
  /// day; never two posts at the same time).
  @@unique([userId, date])
  @@index([scheduleId, date])
}
