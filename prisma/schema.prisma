// Prisma schema. Business models are added by feature, each change through a
// reviewed migration (`npm run db:migrate -- --name <change>`).
// Connection settings live in prisma7.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Authentication profile. Captain and administrator are assignments, not
/// roles (see PostAssignment.isCaptain and User.isAdmin).
enum Role {
  AUTHORITY
  COORDINATOR
  LIFEGUARD
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  /// Login identifier, stored lowercase.
  username            String    @unique
  name                String
  role                Role
  /// May manage user accounts, posts and coordinator areas.
  isAdmin             Boolean   @default(false)
  /// Inactive users cannot sign in; their sessions are revoked.
  active              Boolean   @default(true)
  passwordHash        String
  /// Set for temporary passwords; the user must choose a new one.
  mustChangePassword  Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions                   Session[]
  coordinatedPosts           PostCoordinator[]
  assignments                PostAssignment[]
  auditEntries               AuditLog[]                  @relation("AuditActor")
  openedWindows              AvailabilityWindow[]
  availabilities             Availability[]
  scheduleEntries            ScheduleEntry[]             @relation("ScheduledUser")
  createdEntries             ScheduleEntry[]             @relation("EntryCreator")
  confirmedSchedules         Schedule[]                  @relation("ScheduleConfirmer")
  journeys                   Journey[]
  attendanceRecords          AttendanceRecord[]
  attendanceDecisions        AttendanceDecision[]
  checklistItems             ChecklistItem[]
  checklistItemVersions      ChecklistItemVersion[]
  checklists                 Checklist[]
  checklistRevisions         ChecklistRevision[]
  occurrenceCategories       OccurrenceCategory[]
  occurrenceCategoryVersions OccurrenceCategoryVersion[]
  occurrences                Occurrence[]
  occurrenceAnnulments       OccurrenceAnnulment[]
  alerts                     ReinforcementAlert[]
  alertEvents                AlertEvent[]
}

model Session {
  /// SHA-256 of the session token. The token itself is only in the cookie.
  id                String   @id
  userId            String   @db.Uuid
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  /// Idle expiry, extended on use up to absoluteExpiresAt.
  expiresAt         DateTime
  absoluteExpiresAt DateTime

  @@index([userId])
}

/// Operational state of a post. Provisional values (OD-03).
enum PostStatus {
  /// In service: schedules and team changes allowed.
  OPERATING
  /// Temporarily out of service: no new schedule entries.
  SUSPENDED
  /// Deactivated: kept for history only.
  INACTIVE
}

model Post {
  id                    String     @id @default(uuid()) @db.Uuid
  /// Short identifier chosen by the administrator, e.g. "P-01". Uppercase.
  code                  String     @unique
  name                  String     @unique
  /// Free-text location (beach, reference point).
  location              String     @default("")
  /// Information needed for the service, until OD-03 defines fields.
  notes                 String     @default("")
  status                PostStatus @default(OPERATING)
  /// Reference point for the proximity check. Optional: without it, or
  /// without an approved radius, proximity is not evaluated (OD-29).
  latitude              Float?
  longitude             Float?
  proximityRadiusMeters Int?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  coordinators   PostCoordinator[]
  assignments    PostAssignment[]
  schedules      Schedule[]
  journeys       Journey[]
  attendance     AttendanceRecord[]
  checklistItems ChecklistItem[]
  checklists     Checklist[]
  occurrences    Occurrence[]
  alerts         ReinforcementAlert[]
  auditEntries   AuditLog[]
}

/// A coordinator's area of responsibility.
model PostCoordinator {
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/// A lifeguard's base assignment to a post (the post's team). Only team
/// members can be scheduled at the post.
model PostAssignment {
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isCaptain Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/// Append-only change history. Never updated or deleted by the application.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  createdAt  DateTime @default(now())
  /// Null only for changes made by the command-line bootstrap.
  actorId    String?  @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  /// Post the change belongs to, when it has one.
  postId     String?  @db.Uuid
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Restrict)
  /// Changed fields only. Never contains password hashes or tokens.
  before     Json?
  after      Json?
  /// Justification, required for some changes (e.g. confirmed schedules).
  reason     String?

  @@index([entityType, entityId])
  @@index([postId, createdAt])
  @@index([actorId, createdAt])
}

enum AvailabilityWindowStatus {
  /// Lifeguards can send or change their availability.
  OPEN
  /// No more changes to availability.
  CLOSED
}

/// Three consecutive days for which lifeguards declare availability.
/// Windows never overlap (checked by the application).
model AvailabilityWindow {
  id          String                   @id @default(uuid()) @db.Uuid
  /// First day; the window covers startDate and the two following days.
  startDate   DateTime                 @unique @db.Date
  status      AvailabilityWindowStatus @default(OPEN)
  createdById String                   @db.Uuid
  createdBy   User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  availabilities Availability[]
  schedules      Schedule[]
}

/// Availability sent by a lifeguard for one window ("disponibilidade
/// enviada"). It is a declaration only: it never becomes a schedule by itself.
model Availability {
  windowId    String             @db.Uuid
  window      AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)
  userId      String             @db.Uuid
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  day1        Boolean
  day2        Boolean
  day3        Boolean
  note        String             @default("")
  submittedAt DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@id([windowId, userId])
  @@index([userId])
}

enum ScheduleStatus {
  /// Being assembled by the coordinator. Not visible to lifeguards.
  PROPOSED
  /// Confirmed by the coordinator and published.
  CONFIRMED
  /// Changed after confirmation (each change has a justification).
  CHANGED
}

/// Schedule of one post for one availability window.
model Schedule {
  id            String             @id @default(uuid()) @db.Uuid
  postId        String             @db.Uuid
  post          Post               @relation(fields: [postId], references: [id], onDelete: Restrict)
  windowId      String             @db.Uuid
  window        AvailabilityWindow @relation(fields: [windowId], references: [id], onDelete: Restrict)
  status        ScheduleStatus     @default(PROPOSED)
  confirmedAt   DateTime?
  confirmedById String?            @db.Uuid
  confirmedBy   User?              @relation("ScheduleConfirmer", fields: [confirmedById], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  entries ScheduleEntry[]

  @@unique([postId, windowId])
  @@index([windowId])
}

/// One lifeguard at one post on one day.
model ScheduleEntry {
  id          String   @id @default(uuid()) @db.Uuid
  scheduleId  String   @db.Uuid
  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  userId      String   @db.Uuid
  user        User     @relation("ScheduledUser", fields: [userId], references: [id], onDelete: Restrict)
  /// Operational day (America/Sao_Paulo calendar date).
  date        DateTime @db.Date
  createdById String   @db.Uuid
  createdBy   User     @relation("EntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  /// A person is at one post per day, in any schedule state (one shift per
  /// day; never two posts at the same time).
  @@unique([userId, date])
  @@index([scheduleId, date])
}

enum AttendanceKind {
  CHECK_IN
  CHECK_OUT
}

/// How the record reached the server. Decided by the server, not the device.
enum AttendanceOrigin {
  /// Sent at the moment of registration; the server time is the official time.
  ONLINE
  /// Saved on the device without internet and synchronized later. Provisional
  /// until a coordinator validates it.
  OFFLINE
}

/// Server-side states. "Saved on the device" and "waiting to synchronize"
/// exist only on the device (see src/features/attendance/client).
enum AttendanceStatus {
  AWAITING_VALIDATION
  VALIDATED
  REJECTED
  /// Divergence found (schedule, clock, distance, duplicate...): a person
  /// must look at it. Never discarded automatically.
  UNDER_REVIEW
}

enum LocationStatus {
  CAPTURED
  DENIED
  UNAVAILABLE
  TIMEOUT
  UNSUPPORTED
}

/// One lifeguard's shift on one operational day (one per day). Created by
/// the first check-in; append-only (database trigger).
model Journey {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  date      DateTime @db.Date
  postId    String   @db.Uuid
  post      Post     @relation(fields: [postId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  records   AttendanceRecord[]
  checklist Checklist?

  @@unique([userId, date])
  @@index([postId, date])
}

/// An entry or exit exactly as registered. The original data never changes
/// (database trigger); only `status` moves, and every move is an
/// AttendanceDecision.
model AttendanceRecord {
  /// Generated on the device: the idempotency key of the synchronization.
  id             String           @id @db.Uuid
  journeyId      String           @db.Uuid
  journey        Journey          @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  postId         String           @db.Uuid
  post           Post             @relation(fields: [postId], references: [id], onDelete: Restrict)
  kind           AttendanceKind
  /// Equal to `kind` for the journey's entry/exit; NULL for duplicates, so
  /// the unique index allows any number of preserved duplicates.
  primaryKind    AttendanceKind?
  origin         AttendanceOrigin
  /// Clock of the device at registration. Information, not proof.
  deviceTime     DateTime
  /// Server time minus device time, last measured by the device (ms).
  clockOffsetMs  Int?
  receivedAt     DateTime         @default(now())
  locationStatus LocationStatus
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  distanceMeters Float?
  /// Divergence and notice codes found on arrival (see attendance/rules.ts).
  flags          String[]
  /// SHA-256 of the registered data: a different payload with the same id
  /// is refused instead of overwriting the original.
  payloadHash    String
  status         AttendanceStatus

  decisions AttendanceDecision[]

  @@unique([journeyId, primaryKind])
  @@index([postId, status])
  @@index([userId, receivedAt])
}

/// Every status change of a record, including the first one. Append-only.
model AttendanceDecision {
  id          String            @id @default(uuid()) @db.Uuid
  recordId    String            @db.Uuid
  record      AttendanceRecord  @relation(fields: [recordId], references: [id], onDelete: Restrict)
  /// Null when set by the system on arrival.
  decidedById String?           @db.Uuid
  decidedBy   User?             @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  fromStatus  AttendanceStatus?
  toStatus    AttendanceStatus
  reason      String            @default("")
  createdAt   DateTime          @default(now())

  @@index([recordId, createdAt])
}

/// Condition of a checklist item. Provisional options (OD-32).
enum ChecklistItemState {
  OK
  MISSING
  DAMAGED
  INADEQUATE
}

enum ChecklistStatus {
  /// Started, not sent ("incompleto").
  DRAFT
  /// Sent by the lifeguard. Later changes are corrections with a reason.
  SUBMITTED
}

enum ChecklistRevisionKind {
  DRAFT
  SUBMISSION
  CORRECTION
}

/// A checklist item of a post. Its content lives in versions, so editing
/// the list never changes checklists already filled. Append-only.
model ChecklistItem {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String   @db.Uuid
  post        Post     @relation(fields: [postId], references: [id], onDelete: Restrict)
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  versions ChecklistItemVersion[]
  lines    ChecklistLine[]

  @@index([postId])
}

/// One version of an item. The highest `version` is the current one.
/// Append-only.
model ChecklistItemVersion {
  id          String        @id @default(uuid()) @db.Uuid
  itemId      String        @db.Uuid
  item        ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  version     Int
  label       String
  guidance    String        @default("")
  position    Int
  active      Boolean
  createdById String        @db.Uuid
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())

  lines ChecklistLine[]

  @@unique([itemId, version])
}

/// The checklist of one assumption (journey): one per journey, never shared
/// between people. Only status, submittedAt and currentRevisionId change.
model Checklist {
  id                String             @id @default(uuid()) @db.Uuid
  journeyId         String             @unique @db.Uuid
  journey           Journey            @relation(fields: [journeyId], references: [id], onDelete: Restrict)
  userId            String             @db.Uuid
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  postId            String             @db.Uuid
  post              Post               @relation(fields: [postId], references: [id], onDelete: Restrict)
  date              DateTime           @db.Date
  status            ChecklistStatus    @default(DRAFT)
  createdAt         DateTime           @default(now())
  submittedAt       DateTime?
  /// Latest revision (the current answers). Null until the first save.
  currentRevisionId String?            @unique @db.Uuid
  currentRevision   ChecklistRevision? @relation("CurrentRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)

  lines     ChecklistLine[]
  revisions ChecklistRevision[] @relation("Revisions")

  @@index([postId, date])
  @@index([userId, date])
}

/// The list as it was when the checklist started (frozen copy of the item
/// version). Append-only.
model ChecklistLine {
  id            String               @id @default(uuid()) @db.Uuid
  checklistId   String               @db.Uuid
  checklist     Checklist            @relation(fields: [checklistId], references: [id], onDelete: Restrict)
  itemId        String               @db.Uuid
  item          ChecklistItem        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemVersionId String               @db.Uuid
  itemVersion   ChecklistItemVersion @relation(fields: [itemVersionId], references: [id], onDelete: Restrict)
  position      Int
  label         String
  guidance      String               @default("")

  answers ChecklistAnswer[]

  @@unique([checklistId, itemId])
}

/// A full snapshot of the answers at each save. The id is generated by the
/// browser for each attempt, so a repeated request is recognized.
/// Append-only.
model ChecklistRevision {
  id          String                @id @db.Uuid
  checklistId String                @db.Uuid
  checklist   Checklist             @relation("Revisions", fields: [checklistId], references: [id], onDelete: Restrict)
  number      Int
  kind        ChecklistRevisionKind
  authorId    String                @db.Uuid
  author      User                  @relation(fields: [authorId], references: [id], onDelete: Restrict)
  generalNote String                @default("")
  /// Required for corrections.
  reason      String                @default("")
  createdAt   DateTime              @default(now())

  answers   ChecklistAnswer[]
  currentOf Checklist?        @relation("CurrentRevision")

  @@unique([checklistId, number])
}

/// The answer to one line in one revision. Append-only.
model ChecklistAnswer {
  revisionId String              @db.Uuid
  revision   ChecklistRevision   @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  lineId     String              @db.Uuid
  line       ChecklistLine       @relation(fields: [lineId], references: [id], onDelete: Restrict)
  /// Null while unanswered in a draft.
  state      ChecklistItemState?
  note       String              @default("")

  @@id([revisionId, lineId])
  @@index([lineId])
}

/// A kind of operational record (occurrence, preventive action, jellyfish
/// record...). Its name and fields live in versions. Append-only.
model OccurrenceCategory {
  id          String   @id @default(uuid()) @db.Uuid
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  versions    OccurrenceCategoryVersion[]
  occurrences Occurrence[]
}

/// One version of a category: name, guidance and field definitions (see
/// occurrences/fields.ts). The highest version is current. Append-only.
model OccurrenceCategoryVersion {
  id          String             @id @default(uuid()) @db.Uuid
  categoryId  String             @db.Uuid
  category    OccurrenceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  version     Int
  name        String
  description String             @default("")
  active      Boolean
  fields      Json
  createdById String             @db.Uuid
  createdBy   User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime           @default(now())

  occurrences Occurrence[]

  @@unique([categoryId, version])
}

/// An operational record of a post, exactly as registered. It belongs to
/// the post's history; the author is identified, never the owner.
/// Immutable (trigger); errors are handled by an annulment.
model Occurrence {
  /// Generated by the browser: repeating the request stores nothing new.
  id                String                    @id @db.Uuid
  postId            String                    @db.Uuid
  post              Post                      @relation(fields: [postId], references: [id], onDelete: Restrict)
  authorId          String                    @db.Uuid
  author            User                      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categoryId        String                    @db.Uuid
  category          OccurrenceCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// The category version (and so the fields) used when it was registered.
  categoryVersionId String                    @db.Uuid
  categoryVersion   OccurrenceCategoryVersion @relation(fields: [categoryVersionId], references: [id], onDelete: Restrict)
  /// When it happened, as informed by the author.
  occurredAt        DateTime
  /// When the server stored it.
  recordedAt        DateTime                  @default(now())
  description       String                    @default("")
  /// Field values keyed by field key.
  values            Json

  annulment OccurrenceAnnulment?

  @@index([postId, occurredAt])
  @@index([categoryId, occurredAt])
}

/// Marks a record as annulled (registered by mistake), with the reason.
/// The record itself stays unchanged. Append-only.
model OccurrenceAnnulment {
  id           String     @id @default(uuid()) @db.Uuid
  occurrenceId String     @unique @db.Uuid
  occurrence   Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  byId         String     @db.Uuid
  by           User       @relation(fields: [byId], references: [id], onDelete: Restrict)
  reason       String
  createdAt    DateTime   @default(now())
}

/// States of a reinforcement alert (transitions in alerts/rules.ts).
enum AlertStatus {
  /// Sent, not yet acknowledged by the coordination.
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  CLOSED
  CANCELLED
}

/// A request for reinforcement from a post. Stored before the sender is
/// told it was sent. Only `status` changes (trigger); every change is an
/// AlertEvent.
model ReinforcementAlert {
  /// Generated by the browser: repeating the request stores nothing new.
  id          String      @id @db.Uuid
  postId      String      @db.Uuid
  post        Post        @relation(fields: [postId], references: [id], onDelete: Restrict)
  authorId    String      @db.Uuid
  author      User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  description String
  /// Clock of the device when the user pressed send. Information only.
  deviceTime  DateTime
  createdAt   DateTime    @default(now())
  status      AlertStatus @default(OPEN)

  events AlertEvent[]

  @@index([postId, status])
  @@index([status, createdAt])
}

/// Every state change of an alert, with who and when. Append-only.
model AlertEvent {
  id         String             @id @default(uuid()) @db.Uuid
  alertId    String             @db.Uuid
  alert      ReinforcementAlert @relation(fields: [alertId], references: [id], onDelete: Restrict)
  actorId    String             @db.Uuid
  actor      User               @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromStatus AlertStatus?
  toStatus   AlertStatus
  note       String             @default("")
  createdAt  DateTime           @default(now())

  @@index([alertId, createdAt])
}
